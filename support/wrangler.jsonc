    "SUPABASE_URL": "https://booksearcher-api.gabemills.com",
    "SITE_ORIGIN": "https://gabemills.com",
    "APPLE_WEB_ENABLED": "false",
    "DISCORD_GUILD_ID": "1545129215282647220",
    "DISCORD_BOT_ID": "1545131077847220305",
    "DISCORD_SUPPORT_CHANNEL": "1545134645241315408",
    "DISCORD_TICKETS_CATEGORY": "1545139649645645826",
