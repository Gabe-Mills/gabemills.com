# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- added 11 Sep 2026 when the repo was initialised ---
# build output (this project ships dist/ via wrangler, it doesn't need versioning)
/dist
/support/dist
# wrangler local state
/.wrangler
# abandoned Next.js attempt — 436MB of build cache, not source
/.next
# working files from the redesign
/_backup-src-*
/_unused-screenshots
/index.html.bak-*
*.tsbuildinfo
.DS_Store

# third-party skill bundle, not site code
/.claude
